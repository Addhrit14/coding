age = input('enter your age:')
age = int(age)

if age < 12:
    print ('the fare is €2')
    
elif age > 65:
    card = input('do you have a card(yes/no):')
    if card == 'yes':
        print ('there is no fare')
    else:
        print('the fare is €3')
else:
    print('the fare is €5')
